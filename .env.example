# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# (Embedded into the browser bundle via the `define` block in vite.config.ts.)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Alternative for Vercel/standard Vite deployments.
# Vite only exposes VITE_-prefixed variables to the browser, so set this one
# in the Vercel dashboard. Either variable works — VITE_ takes precedence.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (no trailing slash).
# Used for self-referential links — notably the "view property" button in the
# alert emails sent by functions/index.js. Set it as a Cloud Functions env var.
# Current production deployment: https://hettety.vercel.app
APP_URL="https://hettety.vercel.app"
